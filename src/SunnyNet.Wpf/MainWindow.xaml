<Window x:Class="SunnyNet.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SunnyNet.Wpf.Controls"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SunnyNet"
        Icon="Resources/AppIcon.ico"
        Width="1460"
        Height="820"
        MinWidth="980"
        MinHeight="620"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DetailSectionTitleTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SectionTitleTextStyle}">
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="DetailHeaderIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource HeaderIconButtonStyle}">
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style x:Key="DetailBadgeBorderStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource BadgeBorderStyle}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>

        <Style x:Key="DetailBreakpointButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BreakpointButtonStyle}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <Style x:Key="DetailBreakpointWarningButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource DetailBreakpointButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
            <Setter Property="BorderBrush" Value="#F3D7A6" />
        </Style>

        <Style x:Key="DetailBreakpointSuccessButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource DetailBreakpointButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
            <Setter Property="BorderBrush" Value="#BDE2CB" />
        </Style>

        <Style x:Key="DetailBreakpointDangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource DetailBreakpointButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="#F4C3C6" />
        </Style>

        <Style x:Key="DetailTabItemStyle" TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="MinHeight" Value="30" />
        </Style>

        <ControlTemplate x:Key="DetailContentOnlyTabControlTemplate" TargetType="TabControl">
            <ContentPresenter x:Name="PART_SelectedContentHost"
                              ContentSource="SelectedContent"
                              SnapsToDevicePixels="True" />
        </ControlTemplate>

        <Style x:Key="DetailSearchLabelTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="DetailSearchTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="154" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#F0F0F0" />
            <Setter Property="BorderBrush" Value="#DCE5F1" />
            <Setter Property="ToolTip" Value="输入关键词高亮匹配，Enter 查找下一个" />
        </Style>

        <Style x:Key="WorkspaceTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Top"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal"
                                            IsItemsHost="True"
                                            KeyboardNavigation.TabIndex="1" />
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Margin="0,8,0,0"
                                              ContentSource="SelectedContent" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter TargetName="TabBorder" Property="Background" Value="#F5F8FC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="TabBorder" Property="Background" Value="Transparent" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="0"
            Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="Transparent"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30"
                                Height="30"
                                CornerRadius="6"
                                Background="{StaticResource AccentSoftBrush}"
                                IsHitTestVisible="False">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="&#xE774;" />
                        </Border>
                        <primitives:Popup x:Name="LanIpPopup"
                                         AllowsTransparency="True"
                                         Placement="Bottom"
                                         PlacementTarget="{Binding ElementName=LanIpToolbarButton}"
                                         PopupAnimation="Fade"
                                         StaysOpen="False">
                            <Border Width="198"
                                    Padding="20,18"
                                    Background="#F0F0F0"
                                    BorderBrush="#DDE7F2"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" Direction="270" Opacity="0.16" ShadowDepth="8" Color="#1F2D3D" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#7A8CA6" Text="当前内网IP" />
                                    <Border Height="1" Margin="0,10,0,6" Background="#DDE7F2" />
                                    <ItemsControl x:Name="LanIpItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Padding="0"
                                                        HorizontalContentAlignment="Stretch"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="LanIpCopyButton_Click"
                                                        CommandParameter="{Binding}">
                                                    <Border Padding="0,8" BorderBrush="#E4ECF5" BorderThickness="0,0,0,1">
                                                        <TextBlock Foreground="#315F9F" FontSize="14" Text="{Binding}" />
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </primitives:Popup>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="SunnyNet" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Windows Capture Studio" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                MouseLeftButtonDown="WindowControls_MouseLeftButtonDown">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="Minimize_Click" ToolTip="最小化">
                            <TextBlock Style="{StaticResource GlyphTextStyle}" Text="&#xE949;" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="Maximize_Click" ToolTip="最大化/还原">
                            <TextBlock x:Name="MaximizeGlyph" Style="{StaticResource GlyphTextStyle}" Text="&#xE739;" />
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseButtonStyle}" Click="Close_Click" ToolTip="关闭">
                            <TextBlock Style="{StaticResource GlyphTextStyle}" Text="&#xE8BB;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="6,6,6,6"
                    Style="{StaticResource CardBorderStyle}">
                <DockPanel Margin="8,4" LastChildFill="True">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Center"
                                  Focusable="False">
                        <StackPanel Orientation="Horizontal">
                            <Menu VerticalAlignment="Center">
                                <MenuItem Header="文件">
                                    <MenuItem Header="打开文件" Click="OpenFile_Click" />
                                    <MenuItem Header="保存选中的文件" Click="SaveSelected_Click" />
                                    <MenuItem Header="保存全部" Click="SaveAll_Click" />
                                </MenuItem>
                            </Menu>

                            <Button Margin="6,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="Settings_Click" ToolTip="程序设置">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource GlyphTextStyle}" Text="&#xE713;" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="设置" />
                                </StackPanel>
                            </Button>
                            <Button Margin="6,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="Find_Click" ToolTip="搜索/查找 (Ctrl+F)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource GlyphTextStyle}" Text="&#xE721;" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="查找" />
                                </StackPanel>
                            </Button>
                            <Menu Margin="6,0,0,0" VerticalAlignment="Center">
                                <MenuItem x:Name="ClearSessionsMenuItem"
                                          Padding="10,6"
                                          ToolTip="按类型清除会话列表">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource GlyphTextStyle}" Text="&#xE74D;" />
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="清除" />
                                            <TextBlock Margin="4,1,0,0"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe UI Symbol"
                                                       FontSize="9"
                                                       Text="▼" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                    <MenuItem Header="清除所有" InputGestureText="Ctrl+X" Tag="All" Click="ClearSessionsByRule_Click" />
                                    <MenuItem Header="清除资源" Tag="Resources" Click="ClearSessionsByRule_Click" />
                                    <MenuItem Header="清除无响应" Tag="NoResponse" Click="ClearSessionsByRule_Click" />
                                    <MenuItem Header="清除失败请求" Tag="Failed" Click="ClearSessionsByRule_Click" />
                                    <MenuItem Header="清除重定向" Tag="Redirect" Click="ClearSessionsByRule_Click" />
                                    <Separator />
                                    <MenuItem Header="清除未标记" Tag="Untagged" Click="ClearSessionsByRule_Click" />
                                    <MenuItem Header="清除当前筛选结果" Tag="CurrentFilter" Click="ClearSessionsByRule_Click" />
                                    <Separator />
                                    <MenuItem Header="清除过滤条件" Click="ClearFilters_Click" />
                                </MenuItem>
                            </Menu>
                            <Button Margin="6,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ReleaseAllCommand}" ToolTip="全部放行">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource GlyphTextStyle}" Text="&#xE768;" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="全部放行" />
                                </StackPanel>
                            </Button>

                            <ToggleButton x:Name="AutoScrollToolbarButton"
                                          Margin="6,0,0,0"
                                          Style="{StaticResource ToolbarToggleButtonStyle}"
                                          IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                                          Click="AutoScrollToolbarButton_Click"
                                          ToolTip="列表自动跟随显示">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource GlyphTextStyle}" Text="&#xE73E;" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="自动滚动显示" />
                                </StackPanel>
                            </ToggleButton>
                            <Button Margin="6,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="TextCompare_Click" ToolTip="文本工具">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource GlyphTextStyle}" Text="&#xE8D2;" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="文本工具" />
                                </StackPanel>
                            </Button>
                            <Button Margin="6,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="JsonTool_Click" ToolTip="JSON工具">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource GlyphTextStyle}" Text="&#xE8A5;" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="JSON" />
                                </StackPanel>
                            </Button>
                            <Button Margin="6,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="CryptoTool_Click" ToolTip="加密/解密">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource GlyphTextStyle}" Text="&#xE72E;" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="加密/解密" />
                                </StackPanel>
                            </Button>
                            <Button Margin="6,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="RequestBuilder_Click" ToolTip="请求构造器">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource GlyphTextStyle}" Text="&#xE8F1;" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="请求构造器" />
                                </StackPanel>
                            </Button>
                            <Button Margin="6,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="SessionCompare_Click" ToolTip="会话比较">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource GlyphTextStyle}" Text="&#xE8AB;" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="比较" />
                                </StackPanel>
                            </Button>
                            <Button Margin="6,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="CertificateGuide_Click" ToolTip="证书安装教程">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource GlyphTextStyle}" Text="&#xE7C3;" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="证书教程" />
                                </StackPanel>
                            </Button>
                            <Button Margin="6,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="OpenSource_Click" ToolTip="开源协议">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource GlyphTextStyle}" Text="&#xE82D;" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="开源协议" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="LanIpToolbarButton"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="LanIpToolbarButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource GlyphTextStyle}" Text="&#xE774;" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="显示内网" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid x:Name="WorkspaceGrid" Grid.Row="2" Margin="12,0,12,12" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="WorkspaceSessionColumn" Width="2*" MinWidth="420" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition x:Name="WorkspaceDetailColumn" Width="3*" MinWidth="520" />
                </Grid.ColumnDefinitions>

                <Border x:Name="SessionListPanel" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <Border.Resources>
                        <Style x:Key="FavoritesOnlyToggleStyle" TargetType="{x:Type ToggleButton}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="6,3,8,3" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="Root"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#F5F8FC" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#C4E8D3" />
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#198754" />
                                                <Setter TargetName="Root" Property="BorderThickness" Value="3,0,0,0" />
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsChecked" Value="True" />
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Root" Property="Background" Value="#B0DEC4" />
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#198754" />
                                                <Setter TargetName="Root" Property="BorderThickness" Value="3,0,0,0" />
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="FavoritesOnlyTextStyle" TargetType="{x:Type TextBlock}">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="#6F7F93" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowTaggedOnly}" Value="True">
                                    <Setter Property="Foreground" Value="#143A28" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="FavoritesOnlyStarStyle" TargetType="{x:Type TextBlock}">
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Foreground" Value="#D8A900" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowTaggedOnly}" Value="True">
                                    <Setter Property="Foreground" Value="#0F6B3C" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="StructureLinkButtonStyle" TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="2,0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Foreground" Value="#2AA96B" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="StructureExpanderStyle" TargetType="{x:Type Expander}">
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Expander}">
                                        <StackPanel>
                                            <ToggleButton x:Name="HeaderSite"
                                                          Background="Transparent"
                                                          BorderBrush="Transparent"
                                                          BorderThickness="0"
                                                          Focusable="False"
                                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                          Padding="0,1,0,3">
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock x:Name="Chevron"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="11"
                                                               Foreground="#2D3C50"
                                                               Text="&#xE70D;" />
                                                    <ContentPresenter Margin="6,0,0,0"
                                                                      VerticalAlignment="Center"
                                                                      RecognizesAccessKey="True"
                                                                      ContentSource="Header"
                                                                      TextElement.Foreground="#24364A"
                                                                      TextElement.FontSize="13"
                                                                      TextElement.FontWeight="SemiBold" />
                                                </DockPanel>
                                            </ToggleButton>
                                            <ContentPresenter x:Name="ExpandSite"
                                                              Margin="14,0,0,1"
                                                              Visibility="Collapsed"
                                                              Focusable="False" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger SourceName="HeaderSite" Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="StructureFilterIconStyle" TargetType="{x:Type TextBlock}">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Foreground" Value="#8AA9C8" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Foreground" Value="#0F6B3C" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="StructureFilterTextStyle" TargetType="{x:Type TextBlock}">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Foreground" Value="#6F7F93" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Foreground" Value="#143A28" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="StructureListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <EventSetter Event="RequestBringIntoView" Handler="StructureFilterItem_RequestBringIntoView" />
