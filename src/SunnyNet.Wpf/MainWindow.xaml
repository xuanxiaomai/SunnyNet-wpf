                                                        <Thumb x:Name="PART_LeftHeaderGripper"
                                                               HorizontalAlignment="Left"
                                                               Style="{StaticResource SessionColumnHeaderGripperStyle}" />
                                                        <Thumb x:Name="PART_RightHeaderGripper"
                                                               HorizontalAlignment="Right"
                                                               Style="{StaticResource SessionColumnHeaderRightGripperStyle}" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="HeaderBorder" Property="Background" Value="#E4EAF1" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="HeaderBorder" Property="Background" Value="#D5DEE8" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style x:Key="SessionIndexHeaderStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource SessionColumnHeaderStyle}">
                                        <Setter Property="Padding" Value="20,5,12,5" />
                                    </Style>
                                    <Style x:Key="SessionIndexTextStyle" TargetType="{x:Type TextBlock}">
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="TextDecorations" Value="{Binding RowTextDecorations}" />
                                    </Style>
                                    <Style x:Key="SessionIconImageStyle" TargetType="{x:Type Image}">
                                        <Setter Property="Width" Value="16" />
                                        <Setter Property="Height" Value="16" />
                                        <Setter Property="Source" Value="{Binding SessionIconImage}" />
                                        <Setter Property="ToolTip" Value="{Binding SessionIconToolTip}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="SnapsToDevicePixels" Value="True" />
                                        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
                                    </Style>
                                    <Style x:Key="SessionMethodTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MethodCellTextStyle}">
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Setter Property="TextDecorations" Value="{Binding RowTextDecorations}" />
                                    </Style>
                                    <Style x:Key="SessionStateTextStyle" TargetType="{x:Type TextBlock}">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{Binding StatusBrush}" />
                                        <Setter Property="TextDecorations" Value="{Binding RowTextDecorations}" />
                                    </Style>
                                    <Style x:Key="SessionTextCellTextStyle" TargetType="{x:Type TextBlock}">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="TextDecorations" Value="{Binding RowTextDecorations}" />
                                    </Style>
                                    <Style x:Key="SessionUrlTextCellTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SessionTextCellTextStyle}">
                                        <Setter Property="ToolTip" Value="{Binding Url}" />
                                        <Setter Property="Foreground" Value="{Binding UrlForeground}" />
                                        <Setter Property="FontWeight" Value="{Binding UrlFontWeight}" />
                                    </Style>
                                    <Style x:Key="SessionNotesEditingStyle" TargetType="{x:Type TextBox}">
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource SessionColumnHeaderStyle}" />
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <StaticResource ResourceKey="SessionGridCellStyle" />
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Setter Property="MinHeight" Value="26" />
                                        <Setter Property="Background" Value="{Binding RowBackground}" />
                                        <Setter Property="ToolTip" Value="{Binding RuleHitSummary}" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#B5D0F5" />
                                                <Setter Property="Foreground" Value="#0D3B66" />
                                            </Trigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                                    <Condition Binding="{Binding IsIntercepted}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#FFB35F" />
                                                <Setter Property="Foreground" Value="#1F2937" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                                    <Condition Binding="{Binding HasBlockRuleHits}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#FFD1AD" />
                                                <Setter Property="Foreground" Value="#7C2D12" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn x:Name="IndexColumn" Header="#" Width="82" MinWidth="76" IsReadOnly="True" CellStyle="{StaticResource SessionIndexCellStyle}" HeaderStyle="{StaticResource SessionIndexHeaderStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Border Width="3"
                                                            Margin="0,3,0,3"
                                                            HorizontalAlignment="Left"
                                                            Background="{Binding RowAccentBrush}"
                                                            CornerRadius="0,2,2,0" />
                                                    <StackPanel Margin="16,0,0,0"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Image Style="{StaticResource SessionIconImageStyle}" />
                                                        <TextBlock Margin="7,0,0,0"
                                                                   Style="{StaticResource SessionIndexTextStyle}"
                                                                   Text="{Binding Index}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn x:Name="MethodColumn" Header="方式" Binding="{Binding DisplayMethod}" Width="62" MinWidth="52" IsReadOnly="True" ElementStyle="{StaticResource SessionMethodTextStyle}" />
                                    <DataGridTextColumn x:Name="UrlColumn" Header="URL" Binding="{Binding Url}" Width="360" MinWidth="180" IsReadOnly="True" ElementStyle="{StaticResource SessionUrlTextCellTextStyle}" />
                                    <DataGridTextColumn x:Name="StateColumn" Header="状态" Binding="{Binding State}" Width="68" MinWidth="56" IsReadOnly="True" ElementStyle="{StaticResource SessionStateTextStyle}" />
                                    <DataGridTextColumn x:Name="LengthColumn" Header="长度" Binding="{Binding ResponseLength}" Width="96" MinWidth="64" IsReadOnly="True" ElementStyle="{StaticResource SessionTextCellTextStyle}" />
                                    <DataGridTextColumn x:Name="TypeColumn" Header="类型" Binding="{Binding ResponseType}" Width="104" MinWidth="72" IsReadOnly="True" ElementStyle="{StaticResource SessionTextCellTextStyle}" />
                                    <DataGridTextColumn x:Name="NotesColumn" Header="备注" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="140" MinWidth="80" ElementStyle="{StaticResource SessionTextCellTextStyle}" EditingElementStyle="{StaticResource SessionNotesEditingStyle}" />
                                    <DataGridTextColumn x:Name="ProcessColumn" Header="进程" Binding="{Binding Process}" Width="92" MinWidth="72" IsReadOnly="True" ElementStyle="{StaticResource SessionTextCellTextStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                    </Grid>
                </Border>

                <GridSplitter x:Name="WorkspaceSplitter" Grid.Column="1" Width="10" HorizontalAlignment="Stretch" DragCompleted="LayoutSplitter_DragCompleted" />

                <Grid x:Name="DetailHostGrid" Grid.Column="2">
                    <TabControl x:Name="WorkspaceTabControl"
                                Background="Transparent"
                                Style="{StaticResource WorkspaceTabControlStyle}"
                                SelectionChanged="WorkspaceTabControl_SelectionChanged">
                        <TabItem x:Name="SessionListTab" Style="{StaticResource WorkspaceTabItemStyle}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Text="&#xE8A5;" />
                                    <TextBlock VerticalAlignment="Center" Text="检查会话" />
                                </StackPanel>
                            </TabItem.Header>
                    <Border x:Name="RequestDataPanel"
                            Background="Transparent"
                            BorderThickness="0">
                        <Grid x:Name="RequestResponseGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="RequestPanelRow" Height="*" />
                                <RowDefinition x:Name="DetailSplitterRow" Height="8" />
                                <RowDefinition x:Name="ResponsePanelRow" Height="*" />
                            </Grid.RowDefinitions>

                            <Border x:Name="RequestSectionBorder"
                                    Grid.Row="0"
                                    Style="{StaticResource PanelSectionBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="请选择一个会话">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Detail.HasSelection}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TabControl x:Name="RequestTabControl"
                                                    Margin="8,4,8,8"
                                                    ItemContainerStyle="{StaticResource DetailTabItemStyle}"
                                                    SelectionChanged="RequestTabControl_SelectionChanged">
                                            <TabControl.Style>
                                                <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Detail.HasSelection}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Detail.IsTcpSession}" Value="True">
                                                            <Setter Property="Template" Value="{StaticResource DetailContentOnlyTabControlTemplate}" />
                                                            <Setter Property="Margin" Value="0" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Detail.IsUdpSession}" Value="True">
                                                            <Setter Property="Template" Value="{StaticResource DetailContentOnlyTabControlTemplate}" />
                                                            <Setter Property="Margin" Value="0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TabControl.Style>
                                            <TabItem x:Name="RequestRawTab" Header="原始视图">
                                                <Grid>
                                                    <controls:HttpSyntaxTextBox x:Name="RequestRawViewer"
                                                                                SourceText="{Binding Detail.RequestRaw}"
                                                                                HighlightMode="RequestRaw"
                                                                                SearchText="{Binding Detail.RequestSearchText}"
                                                                                SearchIgnoreCase="{Binding Detail.DetailSearchIgnoreCase}">
                                                        <controls:HttpSyntaxTextBox.Style>
                                                            <Style TargetType="{x:Type controls:HttpSyntaxTextBox}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Detail.IsRequestInlineEditing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </controls:HttpSyntaxTextBox.Style>
                                                    </controls:HttpSyntaxTextBox>
                                                    <TextBox AcceptsReturn="True"
                                                             AcceptsTab="True"
                                                             FontFamily="Consolas, Microsoft YaHei UI"
                                                             FontSize="11.5"
                                                             HorizontalScrollBarVisibility="Auto"
                                                             Text="{Binding Detail.EditableRequestRaw, UpdateSourceTrigger=PropertyChanged}"
                                                             TextWrapping="NoWrap"
                                                             VerticalScrollBarVisibility="Auto">
                                                        <TextBox.Style>
                                                            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Setter Property="Padding" Value="10" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Detail.IsRequestInlineEditing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </Grid>
                                            </TabItem>
                                            <TabItem x:Name="RequestHeadersTab" Header="协议头">
                                                <controls:NameValueTableControl Rows="{Binding Detail.RequestHeaderRows}" EmptyText="无请求协议头" />
                                            </TabItem>
                                            <TabItem x:Name="RequestParamsTab" Header="参数视图">
                                                <controls:NameValueTableControl Rows="{Binding Detail.RequestQueryRows}" EmptyText="无请求参数" />
                                            </TabItem>
                                            <TabItem x:Name="RequestBodyTab" Header="请求数据">
                                                <controls:RequestBodyView x:Name="RequestBodyViewer"
                                                                          RawText="{Binding Detail.RequestBody}"
                                                                          SearchText="{Binding Detail.RequestSearchText}"
                                                                          SearchIgnoreCase="{Binding Detail.DetailSearchIgnoreCase}"
                                                                          UrlEncodedRows="{Binding Detail.RequestBodyRows}"
                                                                          HasUrlEncodedRows="{Binding Detail.HasRequestBodyRows}" />
                                            </TabItem>
                                            <TabItem x:Name="RequestHexTab" Header="HEX视图">
                                                <controls:HexViewControl Bytes="{Binding Detail.RequestHexBytes}"
                                                                         HeaderLength="{Binding Detail.RequestHexHeaderLength}"
                                                                         VirtualSource="{Binding Detail.RequestHexSource}"
                                                                         EnableBodyCopyActions="True"
                                                                         EmptyText="无请求十六进制数据" />
                                            </TabItem>
                                            <TabItem x:Name="RequestCookiesTab" Header="Cookies">
                                                <controls:NameValueTableControl Rows="{Binding Detail.RequestCookieRows}" EmptyText="无请求 Cookies" />
                                            </TabItem>
                                            <TabItem x:Name="RequestJsonTab" Header="JSON视图">
                                                <controls:JsonTreeViewControl JsonText="{Binding Detail.RequestJson}" />
                                            </TabItem>
                                            <TabItem x:Name="RequestXmlTab" Header="XML视图">
                                                <controls:HttpSyntaxTextBox x:Name="RequestXmlViewer"
                                                                            SourceText="{Binding Detail.RequestXml}"
                                                                            HighlightMode="Body"
                                                                            SearchText="{Binding Detail.RequestSearchText}"
                                                                            SearchIgnoreCase="{Binding Detail.DetailSearchIgnoreCase}" />
                                            </TabItem>
                                            <TabItem x:Name="RequestTlsFingerprintTab" Header="TLS指纹">
                                                <controls:NameValueTableControl Rows="{Binding Detail.RequestTlsFingerprintRows}"
                                                                                EmptyText="无 TLS 指纹"
                                                                                ShowExtraColumn="False" />
                                            </TabItem>
                                            <TabItem x:Name="RequestWebSocketTab" Header="WebSocket">
                                                <TabItem.Style>
                                                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Detail.IsWebSocketSession}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TabItem.Style>
                                                <controls:WebSocketMessagesControl Entries="{Binding Detail.SocketEntries}"
                                                                                   SelectedEntry="{Binding Detail.SelectedSocketEntry, Mode=TwoWay}"
                                                                                   DisplayMode="Flow"
                                                                                   Theology="{Binding SelectedSession.Theology, TargetNullValue=0}" />
                                            </TabItem>
                                            <TabItem x:Name="RequestTcpTab" Header="TCP">
                                                <TabItem.Style>
                                                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Detail.IsTcpSession}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TabItem.Style>
                                                <controls:TcpMessagesControl Entries="{Binding Detail.SocketEntries}"
                                                                             SelectedEntry="{Binding Detail.SelectedSocketEntry, Mode=TwoWay}"
                                                                             DisplayMode="Flow"
                                                                             Theology="{Binding SelectedSession.Theology, TargetNullValue=0}" />
                                            </TabItem>
                                            <TabItem x:Name="RequestUdpTab" Header="UDP">
                                                <TabItem.Style>
                                                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Detail.IsUdpSession}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TabItem.Style>
                                                <controls:UdpMessagesControl Entries="{Binding Detail.SocketEntries}"
                                                                             SelectedEntry="{Binding Detail.SelectedSocketEntry, Mode=TwoWay}"
                                                                             DisplayMode="Flow"
                                                                             Theology="{Binding SelectedSession.Theology, TargetNullValue=0}" />
                                            </TabItem>
                                        </TabControl>
                                    </Grid>

                                    <Border Grid.Row="1"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="0,1,0,0"
                                            CornerRadius="0,0,8,8">
                                        <DockPanel Margin="8,4" LastChildFill="False">
                                            <Button DockPanel.Dock="Right"
                                                    Style="{StaticResource DetailHeaderIconButtonStyle}"
                                                    Click="RequestZoom_Click"
                                                    ToolTip="放大或还原请求区域">
                                                <TextBlock x:Name="RequestZoomGlyph" Style="{StaticResource GlyphTextStyle}" Text="&#xE740;" />
                                            </Button>
                                            <StackPanel DockPanel.Dock="Right"
                                                        Margin="0,0,8,0"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Detail.IsHttpSession}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Style="{StaticResource DetailSearchLabelTextStyle}" Text="查找" />
                                                <TextBox x:Name="RequestDetailSearchTextBox"
                                                         Style="{StaticResource DetailSearchTextBoxStyle}"
                                                         KeyDown="RequestDetailSearchTextBox_KeyDown"
                                                         Text="{Binding Detail.RequestSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <GridSplitter x:Name="RequestResponseSplitter"
                                          Grid.Row="1"
                                          Height="8"
                                          HorizontalAlignment="Stretch"
                                          ResizeDirection="Rows"
                                          ResizeBehavior="PreviousAndNext"
                                          DragCompleted="LayoutSplitter_DragCompleted" />

                            <Border x:Name="ResponseSectionBorder"
                                    Grid.Row="2"
                                    Style="{StaticResource PanelSectionBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="此请求正在发送中">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Detail.HasSelection}" Value="True" />
                                                                <Condition Binding="{Binding Detail.IsHttpSession}" Value="True" />
                                                                <Condition Binding="{Binding Detail.ResponseHeaders}" Value="" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TabControl x:Name="ResponseTabControl"
                                                    Margin="8,4,8,8"
                                                    ItemContainerStyle="{StaticResource DetailTabItemStyle}">
                                            <TabControl.Style>
                                                <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Detail.HasSelection}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Detail.IsTcpSession}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Detail.IsUdpSession}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TabControl.Style>
                                            <TabItem x:Name="ResponseRawTab" Header="原始响应">
                                                <Grid>
                                                    <controls:HttpSyntaxTextBox x:Name="ResponseRawViewer"
                                                                                SourceText="{Binding Detail.ResponseRaw}"
                                                                                HighlightMode="ResponseRaw"
                                                                                SearchText="{Binding Detail.ResponseSearchText}"
                                                                                SearchIgnoreCase="{Binding Detail.DetailSearchIgnoreCase}">
                                                        <controls:HttpSyntaxTextBox.Style>
                                                            <Style TargetType="{x:Type controls:HttpSyntaxTextBox}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Detail.IsResponseInlineEditing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </controls:HttpSyntaxTextBox.Style>
                                                    </controls:HttpSyntaxTextBox>
                                                    <TextBox AcceptsReturn="True"
                                                             AcceptsTab="True"
                                                             FontFamily="Consolas, Microsoft YaHei UI"
                                                             FontSize="11.5"
                                                             HorizontalScrollBarVisibility="Auto"
                                                             Text="{Binding Detail.EditableResponseRaw, UpdateSourceTrigger=PropertyChanged}"
                                                             TextWrapping="NoWrap"
                                                             VerticalScrollBarVisibility="Auto">
                                                        <TextBox.Style>
                                                            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Setter Property="Padding" Value="10" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Detail.IsResponseInlineEditing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </Grid>
                                            </TabItem>
                                            <TabItem x:Name="ResponseHeadersTab" Header="协议头">
                                                <controls:NameValueTableControl Rows="{Binding Detail.ResponseHeaderRows}" EmptyText="无响应协议头" />
                                            </TabItem>
                                            <TabItem x:Name="ResponseTextTab" Header="响应文本">
                                                <controls:HttpSyntaxTextBox x:Name="ResponseTextViewer"
                                                                            SourceText="{Binding Detail.ResponseText}"
                                                                            HighlightMode="Body"
                                                                            SearchText="{Binding Detail.ResponseSearchText}"
                                                                            SearchIgnoreCase="{Binding Detail.DetailSearchIgnoreCase}" />
                                            </TabItem>
                                            <TabItem x:Name="ResponseImageTab" Header="图片视图">
                                                <controls:ImagePreviewControl ImageBytes="{Binding Detail.ResponseImageBytes}"
                                                                              ImageType="{Binding Detail.ResponseImageType}"
                                                                              EmptyText="暂无图片响应" />
                                            </TabItem>
                                            <TabItem x:Name="ResponseHtmlTab" Header="HTML视图">
                                                <controls:HtmlPreviewControl HtmlText="{Binding Detail.ResponseHtml}" />
                                            </TabItem>
                                            <TabItem x:Name="ResponseXmlTab" Header="XML视图">
                                                <controls:HttpSyntaxTextBox x:Name="ResponseXmlViewer"
                                                                            SourceText="{Binding Detail.ResponseXml}"
                                                                            HighlightMode="Body"
                                                                            SearchText="{Binding Detail.ResponseSearchText}"
                                                                            SearchIgnoreCase="{Binding Detail.DetailSearchIgnoreCase}" />
                                            </TabItem>
                                            <TabItem x:Name="ResponseHexTab" Header="HEX视图">
                                                <controls:HexViewControl Bytes="{Binding Detail.ResponseHexBytes}"
                                                                         HeaderLength="{Binding Detail.ResponseHexHeaderLength}"
                                                                         VirtualSource="{Binding Detail.ResponseHexSource}"
                                                                         EmptyText="无响应十六进制数据" />
                                            </TabItem>
                                            <TabItem x:Name="ResponseWebSocketTab" Header="文本视图">
                                                <TabItem.Style>
                                                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Detail.IsWebSocketSession}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TabItem.Style>
                                                <controls:WebSocketMessagesControl Entries="{Binding Detail.SocketEntries}"
                                                                                   SelectedEntry="{Binding Detail.SelectedSocketEntry, Mode=TwoWay}"
                                                                                   DisplayMode="PayloadText"
                                                                                   Theology="{Binding SelectedSession.Theology, TargetNullValue=0}" />
                                            </TabItem>
                                            <TabItem x:Name="ResponseWebSocketHexTab" Header="HEX视图">
                                                <TabItem.Style>
                                                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Detail.IsWebSocketSession}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TabItem.Style>
                                                <controls:WebSocketMessagesControl Entries="{Binding Detail.SocketEntries}"
                                                                                   SelectedEntry="{Binding Detail.SelectedSocketEntry, Mode=TwoWay}"
                                                                                   DisplayMode="PayloadHex"
                                                                                   Theology="{Binding SelectedSession.Theology, TargetNullValue=0}" />
                                            </TabItem>
                                            <TabItem x:Name="ResponseWebSocketJsonTab" Header="JSON视图">
                                                <TabItem.Style>
                                                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Detail.IsWebSocketSession}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TabItem.Style>
                                                <controls:WebSocketMessagesControl Entries="{Binding Detail.SocketEntries}"
                                                                                   SelectedEntry="{Binding Detail.SelectedSocketEntry, Mode=TwoWay}"
                                                                                   DisplayMode="PayloadJson"
                                                                                   Theology="{Binding SelectedSession.Theology, TargetNullValue=0}" />
                                            </TabItem>
                                            <TabItem x:Name="ResponseWebSocketProtobufTab" Header="ProtoBuf">
                                                <TabItem.Style>
                                                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Detail.IsWebSocketSession}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TabItem.Style>
                                                <controls:WebSocketMessagesControl Entries="{Binding Detail.SocketEntries}"
                                                                                   SelectedEntry="{Binding Detail.SelectedSocketEntry, Mode=TwoWay}"
                                                                                   DisplayMode="PayloadProtobuf"
                                                                                   Theology="{Binding SelectedSession.Theology, TargetNullValue=0}" />
                                            </TabItem>
                                            <TabItem x:Name="ResponseWebSocketReplayTab" Header="主动发送">
                                                <TabItem.Style>
                                                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Detail.IsWebSocketSession}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TabItem.Style>
                                                <controls:WebSocketMessagesControl Entries="{Binding Detail.SocketEntries}"
                                                                                   SelectedEntry="{Binding Detail.SelectedSocketEntry, Mode=TwoWay}"
                                                                                   DisplayMode="Replay"
                                                                                   Theology="{Binding SelectedSession.Theology, TargetNullValue=0}" />
                                            </TabItem>
                                            <TabItem x:Name="ResponseTcpTab" Header="TCP">
                                                <TabItem.Style>
                                                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Detail.IsTcpSession}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TabItem.Style>
                                                <controls:TcpMessagesControl Entries="{Binding Detail.SocketEntries}"
                                                                             SelectedEntry="{Binding Detail.SelectedSocketEntry, Mode=TwoWay}"
                                                                             DisplayMode="Inspector"
                                                                             Theology="{Binding SelectedSession.Theology, TargetNullValue=0}" />
                                            </TabItem>
                                            <TabItem x:Name="ResponseUdpTab" Header="UDP">
                                                <TabItem.Style>
                                                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Detail.IsUdpSession}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TabItem.Style>
                                                <controls:UdpMessagesControl Entries="{Binding Detail.SocketEntries}"
                                                                             SelectedEntry="{Binding Detail.SelectedSocketEntry, Mode=TwoWay}"
                                                                             DisplayMode="Inspector"
                                                                             Theology="{Binding SelectedSession.Theology, TargetNullValue=0}" />
                                            </TabItem>
                                            <TabItem x:Name="ResponseCookiesTab" Header="Cookies">
                                                <controls:NameValueTableControl Rows="{Binding Detail.ResponseCookieRows}"
                                                                               ShowExtraColumn="True"
                                                                               EmptyText="无响应 Cookies" />
                                            </TabItem>
                                            <TabItem x:Name="ResponseJsonTab" Header="JSON视图">
                                                <controls:JsonTreeViewControl JsonText="{Binding Detail.ResponseJson}" />
                                            </TabItem>
                                        </TabControl>

                                        <controls:TcpMessagesControl Margin="0"
                                                                     Entries="{Binding Detail.SocketEntries}"
                                                                     SelectedEntry="{Binding Detail.SelectedSocketEntry, Mode=TwoWay}"
                                                                     DisplayMode="Inspector"
                                                                     Theology="{Binding SelectedSession.Theology, TargetNullValue=0}">
                                            <controls:TcpMessagesControl.Style>
                                                <Style TargetType="{x:Type controls:TcpMessagesControl}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Detail.HasSelection}" Value="True" />
                                                                <Condition Binding="{Binding Detail.IsTcpSession}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:TcpMessagesControl.Style>
                                        </controls:TcpMessagesControl>

                                        <controls:UdpMessagesControl Margin="0"
                                                                     Entries="{Binding Detail.SocketEntries}"
                                                                     SelectedEntry="{Binding Detail.SelectedSocketEntry, Mode=TwoWay}"
                                                                     DisplayMode="Inspector"
                                                                     Theology="{Binding SelectedSession.Theology, TargetNullValue=0}">
                                            <controls:UdpMessagesControl.Style>
                                                <Style TargetType="{x:Type controls:UdpMessagesControl}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Detail.HasSelection}" Value="True" />
                                                                <Condition Binding="{Binding Detail.IsUdpSession}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:UdpMessagesControl.Style>
                                        </controls:UdpMessagesControl>
                                    </Grid>

                                    <Border Grid.Row="1"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="0,1,0,0"
                                            CornerRadius="0,0,8,8">
                                        <DockPanel Margin="8,4" LastChildFill="False">
                                            <Button DockPanel.Dock="Right"
                                                    Style="{StaticResource DetailHeaderIconButtonStyle}"
                                                    Click="ResponseZoom_Click"
                                                    ToolTip="放大或还原响应区域">
                                                <TextBlock x:Name="ResponseZoomGlyph" Style="{StaticResource GlyphTextStyle}" Text="&#xE740;" />
                                            </Button>
                                            <StackPanel DockPanel.Dock="Right"
                                                        Margin="0,0,8,0"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Detail.IsHttpSession}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Style="{StaticResource DetailSearchLabelTextStyle}" Text="查找" />
                                                <TextBox x:Name="ResponseDetailSearchTextBox"
                                                         Style="{StaticResource DetailSearchTextBoxStyle}"
                                                         KeyDown="ResponseDetailSearchTextBox_KeyDown"
                                                         Text="{Binding Detail.ResponseSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsSelectedSessionIntercepted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Button Margin="0,0,8,0"
                                                        Style="{StaticResource DetailBreakpointWarningButtonStyle}"
                                                        Command="{Binding ResendSelectedCommand}"
                                                        Content="放行当前" />
                                                <Button Margin="0,0,8,0"
                                                        Style="{StaticResource DetailBreakpointSuccessButtonStyle}"
                                                        Command="{Binding ReleaseCurrentCommand}"
                                                        Content="运行到结束" />
                                                <Button Style="{StaticResource DetailBreakpointDangerButtonStyle}"
                                                        Command="{Binding CloseSessionCommand}"
                                                        Content="断开连接" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                        </TabItem>

                        <TabItem x:Name="ReplaceListTab" Style="{StaticResource WorkspaceTabItemStyle}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Text="&#xE8AB;" />
                                    <TextBlock VerticalAlignment="Center" Text="替换列表" />
                                </StackPanel>
                            </TabItem.Header>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="12,10" LastChildFill="False">
                                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                                Click="AddReplaceListRule_Click"
                                                Content="添加替换" />
                                        <Button x:Name="EditReplaceListRuleButton"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                Click="EditReplaceListRule_Click"
                                                Content="编辑" />
                                        <Button x:Name="RemoveReplaceListRuleButton"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                Click="RemoveReplaceListRule_Click"
                                                Content="删除" />
                                    </DockPanel>
                                    <DataGrid x:Name="ReplaceListGrid"
                                              Grid.Row="1"
                                              Margin="0"
                                              ItemsSource="{Binding ReplaceRuleItems}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserResizeRows="False"
                                              HeadersVisibility="Column"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              RowHeight="26"
                                              ColumnHeaderHeight="30"
                                              FontSize="12"
                                              MouseDoubleClick="ReplaceListGrid_MouseDoubleClick"
                                              SelectionChanged="ReplaceListGrid_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="48" />
                                            <DataGridTextColumn Header="替换目标" Binding="{Binding DisplayTarget}" Width="2*" />
                                            <DataGridTextColumn Header="替换类型" Binding="{Binding DataKind}" Width="160" />
                                            <DataGridTextColumn Header="被替换内容" Binding="{Binding SourceContent}" Width="2*" />
                                            <DataGridTextColumn Header="用作替换内容" Binding="{Binding ReplacementContent}" Width="2*" />
                                            <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="90" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </TabItem>

                        <TabItem x:Name="InterceptListTab" Style="{StaticResource WorkspaceTabItemStyle}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="#CF3F32"
                                               Text="&#xE711;" />
                                    <TextBlock VerticalAlignment="Center" Text="拦截列表" />
                                </StackPanel>
                            </TabItem.Header>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="12,10" LastChildFill="False">
                                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                                Click="AddInterceptListRule_Click"
                                                Content="添加拦截" />
                                        <Button x:Name="EditInterceptListRuleButton"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                Click="EditInterceptListRule_Click"
                                                Content="编辑" />
                                        <Button x:Name="RemoveInterceptListRuleButton"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                Click="RemoveInterceptListRule_Click"
                                                Content="删除" />
                                    </DockPanel>
                                    <DataGrid x:Name="InterceptListGrid"
                                              Grid.Row="1"
                                              Margin="0"
                                              ItemsSource="{Binding InterceptListItems}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserResizeRows="False"
                                              HeadersVisibility="Column"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              RowHeight="26"
                                              ColumnHeaderHeight="30"
                                              FontSize="12"
                                              MouseDoubleClick="InterceptListGrid_MouseDoubleClick"
                                              SelectionChanged="InterceptListGrid_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="48" />
                                            <DataGridTextColumn Header="包含" Binding="{Binding Contains}" Width="80" />
                                            <DataGridTextColumn Header="拦截目标" Binding="{Binding Target}" Width="2*" />
                                            <DataGridTextColumn Header="拦截类型" Binding="{Binding InterceptType}" Width="160" />
                                            <DataGridTextColumn Header="挂起进程" Binding="{Binding SuspendProcess}" Width="88" />
                                            <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="90" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </TabItem>
                    </TabControl>

                    <Border x:Name="ColumnPickerPanel"
                            Visibility="Collapsed"
                            Style="{StaticResource CardBorderStyle}">
                        <StackPanel Margin="20,18">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="列选择" />
                            <TextBlock Margin="0,4,0,12" Style="{StaticResource CaptionTextStyle}" Text="切换列表中需要显示的列" />
                            <CheckBox Content="序号" IsChecked="True" Checked="ColumnCheckChanged" Unchecked="ColumnCheckChanged" Tag="{Binding ElementName=IndexColumn}" />
                            <CheckBox Content="方式" IsChecked="True" Checked="ColumnCheckChanged" Unchecked="ColumnCheckChanged" Tag="{Binding ElementName=MethodColumn}" />
                            <CheckBox Content="状态" IsChecked="True" Checked="ColumnCheckChanged" Unchecked="ColumnCheckChanged" Tag="{Binding ElementName=StateColumn}" />
                            <CheckBox Content="请求地址" IsChecked="True" Checked="ColumnCheckChanged" Unchecked="ColumnCheckChanged" Tag="{Binding ElementName=UrlColumn}" />
                            <CheckBox Content="响应长度" IsChecked="True" Checked="ColumnCheckChanged" Unchecked="ColumnCheckChanged" Tag="{Binding ElementName=LengthColumn}" />
                            <CheckBox Content="响应类型" IsChecked="True" Checked="ColumnCheckChanged" Unchecked="ColumnCheckChanged" Tag="{Binding ElementName=TypeColumn}" />
                            <CheckBox Content="进程" IsChecked="True" Checked="ColumnCheckChanged" Unchecked="ColumnCheckChanged" Tag="{Binding ElementName=ProcessColumn}" />
                            <CheckBox Content="备注" IsChecked="True" Checked="ColumnCheckChanged" Unchecked="ColumnCheckChanged" Tag="{Binding ElementName=NotesColumn}" />
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>

            <Border Grid.Row="3"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0">
                <DockPanel Margin="12,0" LastChildFill="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="CaptureScopeComboBox"
                                  Width="126"
                                  Height="30"
                                  Padding="10,4"
                                  SelectedValuePath="Tag"
                                  SelectionChanged="CaptureScopeComboBox_SelectionChanged"
                                  ToolTip="选择抓取所有进程或指定进程">
                            <ComboBoxItem Content="所有进程" Tag="All" />
                            <ComboBoxItem Content="指定进程" Tag="Process" />
                        </ComboBox>
                        <Border Width="1" Margin="8,8" Background="{StaticResource DividerBrush}" />
                        <Button Style="{StaticResource FooterButtonStyle}" Click="IeProxy_Click" Content="{Binding StatusLeft}" />
                        <Border Width="1" Margin="8,8" Background="{StaticResource DividerBrush}" />
                        <Button Style="{StaticResource FooterButtonStyle}" Click="CaptureToggle_Click" Content="{Binding StatusMiddle}" />
                        <Border Width="1" Margin="8,8" Background="{StaticResource DividerBrush}" />
                        <Button Style="{StaticResource FooterButtonStyle}" Click="BreakpointMode_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="BreakpointGlyph" Style="{StaticResource GlyphTextStyle}" Text="&#xF127;" />
                                <TextBlock x:Name="BreakpointLabel" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>
                        <Border Width="1" Margin="8,8" Background="{StaticResource DividerBrush}" />
                        <primitives:ToggleButton MinWidth="72"
                                                 Style="{StaticResource ToolbarToggleButtonStyle}"
                                                 IsChecked="{Binding Mcp.Enabled, Mode=TwoWay}"
                                                 ToolTip="启用或关闭内置 MCP 服务">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Fill" Value="#C3602C" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Mcp.Enabled}" Value="False">
                                                    <Setter Property="Fill" Value="#B6C2D2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Mcp.ServerRunning}" Value="True">
                                                    <Setter Property="Fill" Value="#28A35B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock VerticalAlignment="Center" Text="MCP" />
                            </StackPanel>
                        </primitives:ToggleButton>
                        <Border Width="1" Margin="8,8" Background="{StaticResource DividerBrush}" />
                        <primitives:ToggleButton x:Name="CloudHookToggle"
                                                 MinWidth="92"
                                                 Style="{StaticResource ToolbarToggleButtonStyle}"
                                                 IsChecked="{Binding CloudHook.Enabled, Mode=TwoWay}"
                                                 ToolTip="{Binding CloudHook.ToolTipText}"
                                                 PreviewMouseRightButtonUp="CloudHookToggle_PreviewMouseRightButtonUp">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Fill" Value="#B6C2D2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CloudHook.Enabled}" Value="True">
                                                    <Setter Property="Fill" Value="#C3602C" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CloudHook.Starting}" Value="True">
                                                    <Setter Property="Fill" Value="#E6A23C" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CloudHook.Running}" Value="True">
                                                    <Setter Property="Fill" Value="#28A35B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock VerticalAlignment="Center" Text="{Binding CloudHook.ButtonText}" />
                            </StackPanel>
                        </primitives:ToggleButton>
                        <Popup x:Name="CloudHookLogPopup"
                               AllowsTransparency="True"
                               Placement="Top"
                               PlacementTarget="{Binding ElementName=CloudHookToggle}"
                               StaysOpen="False">
                            <Border Width="560"
                                    Height="300"
                                    Padding="12,10"
                                    Background="#F0F0F0"
                                    BorderBrush="#D8DEE8"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Text="安卓 Cloud Hook 日志" />
                                        <Button DockPanel.Dock="Right"
                                                Padding="10,4"
                                                Click="ClearCloudHookLogs_Click"
                                                Content="清空" />
                                    </DockPanel>
                                    <TextBox x:Name="CloudHookLogTextBox"
                                             AcceptsReturn="True"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             IsReadOnly="True"
                                             Text="{Binding CloudHook.LogText, Mode=OneWay}"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" />
                                </DockPanel>
                            </Border>
                        </Popup>
                        <Border Width="1" Margin="8,8" Background="{StaticResource DividerBrush}" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Text="{Binding Mcp.FooterStatusText}" />
                        <Border Width="1" Margin="8,8" Background="{StaticResource DividerBrush}" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Text="{Binding CloudHook.FooterStatusText}" />
                        <Border Width="1" Margin="8,8" Background="{StaticResource DividerBrush}" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Text="{Binding StatusRight}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border x:Name="MainAlertBorder"
                    Grid.RowSpan="4"
                    Panel.ZIndex="80"
                    MinWidth="292"
                    MaxWidth="560"
                    Margin="0,14,0,0"
                    Padding="14,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="#FEF0F0"
                    BorderBrush="#FDE2E2"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="MainAlertIconBorder"
                            Width="14"
                            Height="14"
                            VerticalAlignment="Center"
                            Background="#F56C6C"
                            CornerRadius="7">
                        <TextBlock x:Name="MainAlertGlyphTextBlock"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="×" />
                    </Border>
                    <TextBlock x:Name="MainAlertTextBlock"
                               MaxWidth="500"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#F56C6C"
                               TextTrimming="CharacterEllipsis"
                               Text="操作失败" />
                    <Button x:Name="MainAlertActionButton"
                            Margin="12,0,0,0"
                            MinWidth="68"
                            Padding="10,3"
                            VerticalAlignment="Center"
                            Click="MainAlertActionButton_Click"
                            Content="查看"
                            Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
