<Window x:Class="SunnyNet.Wpf.Windows.InterceptRuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拦截规则设置"
        Width="860"
        Height="560"
        MinWidth="720"
        MinHeight="480"
        Background="#F0F0F0"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="False">
            <TextBlock VerticalAlignment="Center" Text="包含方式：" />
            <ComboBox x:Name="ContainsComboBox"
                      Width="220"
                      Height="28"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      SelectedIndex="0" />
            <ComboBox x:Name="InterceptTypeComboBox"
                      DockPanel.Dock="Right"
                      Width="220"
                      Height="28"
                      VerticalAlignment="Center"
                      ToolTip="拦截类型" />
            <TextBlock DockPanel.Dock="Right"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Text="拦截类型：" />
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="True">
            <TextBlock VerticalAlignment="Center" Text="拦截目标：" />
        </DockPanel>

        <TextBox x:Name="TargetTextBox"
                 Grid.Row="2"
                 Margin="0,8,0,0"
                 Padding="6,4"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />

        <CheckBox x:Name="SuspendCheckBox"
                  Grid.Row="3"
                  Margin="0,14,0,0"
                  VerticalAlignment="Center"
                  Content="命中后挂起（请求断点）" />

        <StackPanel Grid.Row="4"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="88"
                    Height="30"
                    Margin="0,0,8,0"
                    Click="Accept_Click"
                    Content="添加规则"
                    IsDefault="True" />
            <Button Width="88"
                    Height="30"
                    Click="Cancel_Click"
                    Content="关闭窗口"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
