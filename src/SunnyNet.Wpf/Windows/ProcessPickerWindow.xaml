<Window x:Class="SunnyNet.Wpf.Windows.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择进程"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Cursor="Cross"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonDown="Window_MouseRightButtonDown">
    <Grid>
        <Border x:Name="HighlightBorder"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="0"
                Height="0"
                BorderBrush="#2F7CF6"
                BorderThickness="2"
                Background="#332F7CF6"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                SnapsToDevicePixels="True" />
        <Border x:Name="HintBorder"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Padding="12,8"
                CornerRadius="6"
                Background="#E61F2937"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                IsHitTestVisible="False">
            <StackPanel>
                <TextBlock Foreground="#F8FAFC"
                           FontSize="13"
                           Text="{Binding HintText, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="#CBD5E1"
                           FontSize="11"
                           Text="单击捕获所有同名进程，右键或 Esc 取消" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
